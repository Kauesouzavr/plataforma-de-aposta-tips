# Copie este arquivo para ".env" (uso local) e preencha os valores reais.
# No Render, configure essas mesmas variáveis em Settings > Environment (NÃO suba o .env pro git).

# Chave aleatória e longa, só pra assinar a sessão do Flask. Gere uma nova, não reaproveite.
SECRET_KEY=troque-por-uma-string-aleatoria-bem-grande

# Token de PRODUÇÃO do Mercado Pago. Gere um novo no painel deles,
# já que o token antigo apareceu em texto puro numa conversa e deve ser considerado comprometido.
MP_ACCESS_TOKEN=seu-novo-token-aqui

# Senha para acessar o painel /admin. Escolha algo forte.
ADMIN_PASSWORD=uma-senha-forte-para-o-painel-admin

# URL pública do seu site (sem barra no final)
BASE_URL=https://curso-yvqf.onrender.com

# Connection string do banco PostgreSQL (Supabase, Neon, etc.)
# Pegue em: Supabase > Connect > Direct connection ou Session pooler > Type: URI
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
